#!/usr/bin/env bash
#
# caseantiques-nginx-deploy — root-owned gate for the caseantiques.com nginx customizations.
#
# Installed at /usr/local/sbin/caseantiques-nginx-deploy and run via sudo by the
# `nginxdeploy` user, whose SSH key is pinned to this script with a forced command.
# The single argument is the SSH_ORIGINAL_COMMAND sent by the client:
#
#   export   tar of the live site config dir on stdout (read-only)
#   test     run `nginx -t` (read-only)
#   deploy   tar on stdin -> install allowlisted files -> nginx -t -> reload,
#            restoring the previous files if the test or reload fails
#
# Only the files in ALLOWED can be written. SpinupWP-managed files are never
# touched, and nothing is ever deleted (except a brand-new file on rollback).

set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022

SITE_DIR=/etc/nginx/sites-available/caseantiques.com
BACKUP_ROOT=/var/backups/caseantiques-nginx
LOCK_FILE=/run/caseantiques-nginx-deploy.lock
MAX_BYTES=1048576

# Keep in sync with deploy/custom-files.txt in the repo.
ALLOWED=(
  server/sitemap-cache.conf
  server/kill-malformed-urls.conf
  server/cdn-redirect.conf
  server/cdn-redirect-legacy-paths.conf
  location/cache-stampede-protection.conf
)

log() { echo "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

is_allowed() {
  local f
  for f in "${ALLOWED[@]}"; do
    [[ "$f" == "$1" ]] && return 0
  done
  return 1
}

install_changed() {
  local name
  for name in "${changed[@]}"; do
    if [[ -e "$SITE_DIR/$name" ]]; then
      mkdir -p "$backup/$(dirname "$name")" || return 1
      cp -p "$SITE_DIR/$name" "$backup/$name" || return 1
    fi
    install -o root -g root -m 644 "$tmp/x/$name" "$SITE_DIR/$name" || return 1
  done
}

rollback() {
  local name
  log "Rolling back..."
  for name in "${changed[@]}"; do
    if [[ -f "$backup/$name" ]]; then
      install -o root -g root -m 644 "$backup/$name" "$SITE_DIR/$name"
    else
      rm -f "$SITE_DIR/$name"
    fi
  done
  if nginx -t >&2; then
    log "Rollback complete; previous config is in place and tests clean."
  else
    log "WARNING: config still fails nginx -t after rollback. nginx was NOT reloaded; the running config is unchanged."
  fi
}

do_deploy() {
  exec 9>"$LOCK_FILE"
  flock -n 9 || die "another deploy is running"

  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT

  head -c $((MAX_BYTES + 1)) > "$tmp/in.tar"
  (( $(wc -c < "$tmp/in.tar") <= MAX_BYTES )) || die "payload larger than $MAX_BYTES bytes"
  tar -tf "$tmp/in.tar" > "$tmp/list" || die "payload is not a readable tar archive"

  local name
  local -a incoming=()
  while IFS= read -r name; do
    [[ -z "$name" || "$name" == */ ]] && continue
    is_allowed "$name" || die "refusing '$name': not on the allowlist"
    incoming+=("$name")
  done < "$tmp/list"
  (( ${#incoming[@]} > 0 )) || die "payload contains no deployable files"

  mkdir "$tmp/x"
  tar -xf "$tmp/in.tar" -C "$tmp/x" --no-same-owner --no-same-permissions -- "${incoming[@]}"

  changed=()
  for name in "${incoming[@]}"; do
    [[ -f "$tmp/x/$name" && ! -L "$tmp/x/$name" ]] || die "'$name' is not a regular file"
    cmp -s "$tmp/x/$name" "$SITE_DIR/$name" 2>/dev/null || changed+=("$name")
  done

  if (( ${#changed[@]} == 0 )); then
    log "No changes: all ${#incoming[@]} file(s) already match the server."
    exit 0
  fi

  backup="$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$backup"
  chmod 700 "$BACKUP_ROOT"

  if ! install_changed; then
    rollback
    die "could not install files"
  fi

  if ! nginx -t >&2; then
    rollback
    die "nginx -t failed; nothing was reloaded"
  fi

  if ! systemctl reload nginx; then
    rollback
    systemctl reload nginx || true
    die "nginx reload failed"
  fi

  log "Deployed ${#changed[@]} file(s) and reloaded nginx:"
  for name in "${changed[@]}"; do log "  $name"; done
  log "Previous versions saved in $backup"
}

[[ "$(id -u)" -eq 0 ]] || die "must run as root (via sudo)"

case "${1:-}" in
  export) tar -C "$SITE_DIR" -cf - . ;;
  test)   nginx -t >&2 ;;
  deploy) do_deploy ;;
  *)      die "unknown command '${1:-}' (expected: export | test | deploy)" ;;
esac
